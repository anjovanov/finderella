{
	"name": "finderella",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node --env-file=.env server/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"seed": "node --env-file=.env --import tsx scripts/seed.ts",
		"agent:dev": "npm run dev --workspace @finderella/storage-gateway --",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/figtree": "^5.3.0",
		"@hugeicons/core-free-icons": "^4.3.0",
		"@hugeicons/svelte": "^1.1.5",
		"@internationalized/date": "^3.12.3",
		"@sveltejs/adapter-node": "^5.3.0",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@types/ws": "^8.18.1",
		"auth": "^1.6.23",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"hls.js": "^1.7.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.5.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.20.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^3.2.0"
	},
	"dependencies": {
		"@finderella/protocol": "*",
		"@videojs/html": "10.0.0-beta.31",
		"better-auth": "^1.6.23",
		"drizzle-orm": "^0.45.2",
		"pino": "^10.3.1",
		"postgres": "^3.4.9",
		"ws": "^8.18.0",
		"zod": "^4.4.3"
	}
}
