# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Finderella storage gateways (media agents)
# Dev-only shared token gateways use to connect before pairing exists.
GATEWAY_DEV_TOKEN=""

# TMDB metadata (optional). Posters, synopses, genres, cast and ratings for
# scanned titles. Either the "API Read Access Token" (v4, long JWT) or the
# v3 "API Key" from https://www.themoviedb.org/settings/api works.
TMDB_API_KEY=""
